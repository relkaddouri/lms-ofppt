#!/bin/sh
# Deux garde-fous, un par famille de panne déjà rencontrée.
#
# Activation, une fois par clone :
#   git config core.hooksPath .githooks

# 1. Un export non-async dans un module « use server » : Next renvoie 500 sur
#    toute l'application, avec un tsc vert. Quatre occurrences.
node scripts/verifie-actions.mjs || {
  echo "Commit interrompu. Corrigez, ou forcez avec --no-verify si vous savez ce que vous faites."
  exit 1
}

# 2. Ce qui part au commit n'est pas ce qu'on croyait y mettre : fichier mort
#    ramassé par un « git add -A », document écrasé par une copie plus
#    ancienne. Trois occurrences.
if [ -z "$PEDAGO_STAGE_OK" ]; then
  node scripts/verifie-stage.mjs || {
    echo "Commit interrompu."
    exit 1
  }
fi
